// Stage 20: statics and constant evaluation.
const DEFAULT_LIMIT = 25;
const int HARD_LIMIT = 100;

class ParserLimits
{
    internal const MAX_DEPTH = DEFAULT_LIMIT * 4;
    static int $initial = 0;
    static writable int $next = 1;
    internal static string $label = "parser";

    static function nextId(): int
    {
        self::next += self::MAX_DEPTH;
        return self::next;
    }
}

let $nextParserId = ParserLimits::nextId();
echo ParserLimits::next;
echo ParserLimits::MAX_DEPTH;
echo HARD_LIMIT;

// Attributes remain syntax-ahead; named arguments are compiler-supported.
#[Module(host: "localhost", port: 3306)]
#[App\Routing\Route(path: "/parser", name: "parser.show")]
#[Test]
#[Module(
    imports: [
        ORMModule::forRoot(
            entities: [],
            synchronize: true,
        ),
    ],
)]
class Parser
{
    internal int $position = 0;
    writable string $name;
    List<Token> $tokens;
    Dictionary<string, int> $counts;
    Set<string> $labels;
    SortedDictionary<int, Token> $orderedTokens;
    SortedSet<int> $orderedPositions;
    PriorityQueue<int> $pendingPositions;
    Deque<Token> $tokenWindow;

    function current(): Token
    {
        return $this->tokens[$this->position];
    }

    internal writable function advance(): void
    {
        $this->position++;
    }
}

trait HasSlug
{
    const MAX_DEPTH = 10;

    function slug(): string
    {
        echo self::MAX_DEPTH;
        return "post";
    }
}

trait TracksChanges
{
    int64 $lastChangedAt;
    int[] $changedLines;
}

class Post
{
    uses HasSlug, TracksChanges;
}

function publish(take Post $post): void
{
    return;
}

