// Stage 28 grammar preparation: syntax is accepted while semantics remain pending.
let $score = match ($option) {
    Option::Some($value) => $value,
    Option::None => 0,
    default => -1,
};

// Planned/future: checked errors.
function loadUser(int $id): User throws UserNotFound, DatabaseError
{
    if ($id < 1) {
        throw new UserNotFound($id);
    }

    return new User();
}

try {
    loadUser(42);
} catch (UserNotFound $e) {
    echo "missing";
} finally {
    echo "done";
}

