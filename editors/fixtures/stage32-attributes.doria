namespace Acme\Metadata;

enum HttpMethod
{
    case Get;
    case Post;
}

#[Attribute]
class Route
{
    function __construct(
        string $path,
        HttpMethod $method = HttpMethod::Get,
    ) {}
}

#[Route(path: "/posts", method: HttpMethod::Post)]
#[Test]
#[PHPExport]
function handle(): void
{
}

