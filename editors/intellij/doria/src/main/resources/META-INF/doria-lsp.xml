<idea-plugin>
  <extensions defaultExtensionNs="com.intellij">
    <platform.lsp.serverSupportProvider implementation="dev.doria.intellij.lsp.DoriaLspServerSupportProvider" />
    <enterHandlerDelegate implementation="dev.doria.intellij.documentation.DoriaDocumentationEnterHandler" />
    <intentionAction>
      <className>dev.doria.intellij.actions.DoriaImportIntention</className>
      <category>Doria</category>
    </intentionAction>
    <intentionAction>
      <className>dev.doria.intellij.actions.DoriaGenerateMethodIntention</className>
      <category>Doria</category>
    </intentionAction>
    <intentionAction>
      <className>dev.doria.intellij.actions.DoriaGenerateFunctionIntention</className>
      <category>Doria</category>
    </intentionAction>
  </extensions>
  <actions>
    <action
      id="dev.doria.intellij.actions.DoriaRefreshProjectAction"
      class="dev.doria.intellij.actions.DoriaRefreshProjectAction"
      text="Refresh Doria Project"
      description="Refresh Doria project metadata and diagnostics">
      <add-to-group group-id="ToolsMenu" anchor="last" />
    </action>
  </actions>
</idea-plugin>
