{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Doria",
  "scopeName": "source.doria",
  "patterns": [
    {
      "include": "#attributes"
    },
    {
      "include": "#invalid"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#closures"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#accessors"
    },
    {
      "include": "#callableCalls"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.doria",
          "begin": "(#\\[)\\s*((?:\\\\?[A-Za-z_][A-Za-z0-9_]*)(?:\\\\[A-Za-z_][A-Za-z0-9_]*)*)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.attribute.begin.doria"
            },
            "2": {
              "name": "entity.name.type.attribute.doria"
            }
          },
          "end": "\\]",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.attribute.end.doria"
            }
          },
          "patterns": [
            {
              "name": "entity.name.type.attribute.doria",
              "match": "(?:\\\\?[A-Z][A-Za-z0-9_]*)(?:\\\\[A-Za-z_][A-Za-z0-9_]*)*(?=\\s*(?:\\(|,|\\]))"
            },
            {
              "include": "#attributeExpression"
            }
          ]
        }
      ]
    },
    "attributeExpression": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(:)",
          "captures": {
            "1": {
              "name": "variable.parameter.attribute.doria"
            },
            "2": {
              "name": "punctuation.separator.key-value.doria"
            }
          }
        },
        {
          "include": "#attributeBrackets"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#types"
        },
        {
          "include": "#accessors"
        },
        {
          "include": "#variables"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#invalid"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "attributeBrackets": {
      "name": "meta.brackets.attribute.doria",
      "begin": "\\[",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.brackets.begin.doria"
        }
      },
      "end": "\\]",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.brackets.end.doria"
        }
      },
      "patterns": [
        {
          "include": "#attributeExpression"
        }
      ]
    },
    "invalid": {
      "patterns": [
        {
          "name": "invalid.illegal.preprocessor.doria",
          "match": "^\\s*#(?:include|define|undef|if|ifdef|ifndef|elif|else|endif|warning|error)\\b.*$"
        },
        {
          "name": "invalid.illegal.operator.strict-comparison.doria",
          "match": "===|!=="
        },
        {
          "name": "invalid.illegal.keyword.rejected.doria",
          "match": "\\b(?:goto|require|require_once|include_once|print|instanceof)\\b|\\buse\\b(?=\\s*\\()"
        },
        {
          "match": "\\b(function)((?:(?:\\s+)|(?:/\\*[\\s\\S]*?\\*/)|(?://[^\\r\\n]*(?:\\r?\\n|$))|(?:#(?!\\[)[^\\r\\n]*(?:\\r?\\n|$)))+)(take)(?=(?:(?:\\s+)|(?:/\\*[\\s\\S]*?\\*/)|(?://[^\\r\\n]*(?:\\r?\\n|$))|(?:#(?!\\[)[^\\r\\n]*(?:\\r?\\n|$)))*\\()",
          "captures": {
            "1": {
              "name": "storage.type.function.doria"
            },
            "3": {
              "name": "invalid.illegal.modifier.function.invocation.doria"
            }
          }
        },
        {
          "match": "(::)(\\s*)(\\$)(?=[A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.accessor.static.doria"
            },
            "3": {
              "name": "invalid.illegal.sigil.static-access.doria"
            }
          }
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.doria",
          "begin": "/\\*\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.doria"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.doria"
            }
          },
          "patterns": [
            {
              "match": "(@method)\\s+(?:(static)\\s+)?((?:\\??[A-Za-z_\\\\][A-Za-z0-9_\\\\]*(?:<[^>]+>)?(?:\\[\\])?)(?:\\|\\??[A-Za-z_\\\\][A-Za-z0-9_\\\\]*(?:<[^>]+>)?(?:\\[\\])?)*)\\s+([A-Za-z_][A-Za-z0-9_]*)",
              "captures": {
                "1": {
                  "name": "keyword.other.documentation.tag.doria"
                },
                "2": {
                  "name": "storage.modifier.static.doria"
                },
                "3": {
                  "name": "storage.type.documentation.doria"
                },
                "4": {
                  "name": "entity.name.function.method.documentation.doria"
                }
              }
            },
            {
              "match": "(@param)\\s+((?:(?:internal|take|writable)\\s+)*)(\\S(?:.*?\\S)?)\\s+(\\$[A-Za-z_][A-Za-z0-9_]*)",
              "captures": {
                "1": {
                  "name": "keyword.other.documentation.tag.doria"
                },
                "2": {
                  "name": "storage.modifier.parameter.documentation.doria"
                },
                "3": {
                  "name": "storage.type.documentation.doria"
                },
                "4": {
                  "name": "variable.other.doria"
                }
              }
            },
            {
              "match": "(@property(?:-read|-write)?)\\s+((?:\\??[A-Za-z_\\\\][A-Za-z0-9_\\\\]*(?:<[^>]+>)?(?:\\[\\])?)(?:\\|\\??[A-Za-z_\\\\][A-Za-z0-9_\\\\]*(?:<[^>]+>)?(?:\\[\\])?)*)\\s+(\\$[A-Za-z_][A-Za-z0-9_]*)",
              "captures": {
                "1": {
                  "name": "keyword.other.documentation.tag.doria"
                },
                "2": {
                  "name": "storage.type.documentation.doria"
                },
                "3": {
                  "name": "variable.other.doria"
                }
              }
            },
            {
              "match": "(@(?:return|throws|var|template|extends|implements))\\s+((?:\\??[A-Za-z_\\\\][A-Za-z0-9_\\\\]*(?:<[^>]+>)?(?:\\[\\])?)(?:\\|\\??[A-Za-z_\\\\][A-Za-z0-9_\\\\]*(?:<[^>]+>)?(?:\\[\\])?)*)",
              "captures": {
                "1": {
                  "name": "keyword.other.documentation.tag.doria"
                },
                "2": {
                  "name": "storage.type.documentation.doria"
                }
              }
            },
            {
              "name": "keyword.other.documentation.tag.doria",
              "match": "@[A-Za-z_][A-Za-z0-9_-]*"
            },
            {
              "include": "#variables"
            }
          ]
        },
        {
          "name": "comment.line.double-slash.doria",
          "match": "//.*$"
        },
        {
          "name": "comment.line.number-sign.doria",
          "match": "#(?!\\[).*$"
        },
        {
          "name": "comment.block.doria",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.doria",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.doria",
              "match": "\\\\."
            },
            {
              "include": "#interpolationExpression"
            }
          ]
        },
        {
          "name": "string.quoted.single.doria",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.doria",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "interpolationExpression": {
      "name": "meta.interpolation.expression.doria",
      "begin": "(\\{)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.interpolation.begin.doria"
        }
      },
      "end": "(\\})",
      "endCaptures": {
        "1": {
          "name": "punctuation.section.interpolation.end.doria"
        }
      },
      "patterns": [
        {
          "include": "#interpolationExpression"
        },
        {
          "include": "#invalid"
        },
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#accessors"
        },
        {
          "include": "#variables"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#types"
        },
        {
          "include": "#calls"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "closures": {
      "patterns": [
        {
          "name": "meta.function.arrow.doria",
          "begin": "\\b(fn)\\s*(\\()",
          "beginCaptures": {
            "1": {
              "name": "keyword.declaration.function.arrow.doria"
            },
            "2": {
              "name": "punctuation.definition.parameters.begin.doria"
            }
          },
          "end": "(=>)",
          "endCaptures": {
            "1": {
              "name": "keyword.operator.closure.arrow.doria"
            }
          },
          "patterns": [
            {
              "name": "storage.modifier.ownership.parameter.doria",
              "match": "\\b(?:writable|take)\\b"
            },
            {
              "name": "variable.parameter.closure.doria",
              "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
            },
            {
              "name": "punctuation.definition.parameters.end.doria",
              "match": "\\)(?=\\s*(?:with\\b|=>))"
            },
            {
              "include": "#closureCaptureList"
            },
            {
              "include": "#types"
            },
            {
              "include": "#punctuation"
            }
          ]
        },
        {
          "name": "meta.function.anonymous.doria",
          "begin": "\\b(function)\\s*(\\()(?=(?:[^(){};]+|\\((?:[^(){};]+|\\([^(){};]*\\))*\\))*\\)\\s*:\\s*\\??[A-Za-z_][A-Za-z0-9_]*(?:\\\\[A-Za-z_][A-Za-z0-9_]*)*(?:<[^>]+>)?(?:\\[\\])*(?:\\s+with\\s*\\([^()]+\\))?\\s*\\{)",
          "beginCaptures": {
            "1": {
              "name": "keyword.declaration.function.anonymous.doria"
            },
            "2": {
              "name": "punctuation.definition.parameters.begin.doria"
            }
          },
          "end": "(\\))(?=\\s*:)",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.parameters.end.doria"
            }
          },
          "patterns": [
            {
              "name": "storage.modifier.ownership.parameter.doria",
              "match": "\\b(?:writable|take)\\b"
            },
            {
              "name": "variable.parameter.closure.doria",
              "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
            },
            {
              "include": "#types"
            },
            {
              "include": "#punctuation"
            }
          ]
        },
        {
          "name": "meta.type.function.doria",
          "begin": "\\b(function)(?:\\s+(writable|once))?\\s*(\\()",
          "beginCaptures": {
            "1": {
              "name": "storage.type.function.doria"
            },
            "2": {
              "name": "storage.modifier.invocation.function.doria"
            },
            "3": {
              "name": "punctuation.definition.parameters.begin.doria"
            }
          },
          "end": "(\\))(?=\\s*:)",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.parameters.end.doria"
            }
          },
          "patterns": [
            {
              "name": "storage.modifier.ownership.parameter.function-type.doria",
              "match": "\\b(?:writable|take)\\b"
            },
            {
              "include": "#typeGrouping"
            },
            {
              "include": "#closures"
            },
            {
              "include": "#types"
            },
            {
              "include": "#punctuation"
            }
          ]
        },
        {
          "include": "#closureCaptureList"
        }
      ]
    },
    "typeGrouping": {
      "name": "meta.group.type.doria",
      "begin": "(\\()(?=\\s*\\??\\s*function\\b)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.type.group.begin.doria"
        }
      },
      "end": "(\\))",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.type.group.end.doria"
        }
      },
      "patterns": [
        {
          "include": "#closures"
        },
        {
          "include": "#types"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "closureCaptureList": {
      "name": "meta.closure.capture-list.doria",
      "begin": "\\b(with)\\s*(\\()",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.closure.capture.doria"
        },
        "2": {
          "name": "punctuation.definition.parameters.begin.doria"
        }
      },
      "end": "(\\))",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.parameters.end.doria"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "name": "storage.modifier.ownership.capture.doria",
          "match": "\\b(?:writable|take)\\b"
        },
        {
          "name": "variable.other.capture.doria",
          "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(const)(?:\\s+(\\??[A-Za-z_][A-Za-z0-9_]*(?:<[^>]+>)?(?:\\[\\])*))?\\s+([A-Z][A-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.declaration.constant.doria"
            },
            "2": {
              "name": "storage.type.doria"
            },
            "3": {
              "name": "constant.other.doria"
            }
          }
        },
        {
          "match": "\\b(namespace)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\\\[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.namespace.doria"
            },
            "2": {
              "name": "entity.name.namespace.doria"
            }
          }
        },
        {
          "name": "meta.trait-composition.legacy-use.doria",
          "begin": "^\\s+(use)\\b(?=\\s+[A-Z][A-Za-z0-9_]*(?:\\s*(?:,|;)))",
          "beginCaptures": {
            "1": {
              "name": "invalid.illegal.keyword.trait-use-old-spelling.doria"
            }
          },
          "end": "(;)",
          "endCaptures": {
            "1": {
              "name": "punctuation.terminator.statement.doria"
            }
          },
          "patterns": [
            {
              "name": "entity.name.type.trait.doria",
              "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
            },
            {
              "name": "punctuation.separator.comma.doria",
              "match": ","
            }
          ]
        },
        {
          "name": "meta.trait-composition.doria",
          "begin": "^\\s+(uses)\\b(?=\\s+[A-Z][A-Za-z0-9_]*(?:\\s*(?:,|;)))",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.trait-uses.doria"
            }
          },
          "end": "(;)",
          "endCaptures": {
            "1": {
              "name": "punctuation.terminator.statement.doria"
            }
          },
          "patterns": [
            {
              "name": "entity.name.type.trait.doria",
              "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
            },
            {
              "name": "punctuation.separator.comma.doria",
              "match": ","
            }
          ]
        },
        {
          "name": "meta.import.doria",
          "begin": "^(use)\\b(?=\\s+(?:[A-Za-z_][A-Za-z0-9_]*(?:\\\\[A-Za-z_][A-Za-z0-9_]*)+(?:\\s+as\\s+[A-Za-z_][A-Za-z0-9_]*)?|[A-Za-z_][A-Za-z0-9_]*(?:\\\\[A-Za-z_][A-Za-z0-9_]*)+\\\\\\{\\s*[A-Za-z_][A-Za-z0-9_]*(?:\\s+as\\s+[A-Za-z_][A-Za-z0-9_]*)?(?:\\s*,\\s*[A-Za-z_][A-Za-z0-9_]*(?:\\s+as\\s+[A-Za-z_][A-Za-z0-9_]*)?)*\\s*,?\\s*\\})\\s*;)",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.import.doria"
            }
          },
          "end": "(;)",
          "endCaptures": {
            "1": {
              "name": "punctuation.terminator.statement.doria"
            }
          },
          "patterns": [
            {
              "match": "(\\bas\\b)\\s+([A-Za-z_][A-Za-z0-9_]*)",
              "captures": {
                "1": {
                  "name": "keyword.operator.alias.doria"
                },
                "2": {
                  "name": "entity.name.type.alias.doria"
                }
              }
            },
            {
              "name": "punctuation.separator.namespace.doria",
              "match": "\\\\"
            },
            {
              "name": "punctuation.section.import.group.begin.doria",
              "match": "\\{"
            },
            {
              "name": "punctuation.section.import.group.end.doria",
              "match": "\\}"
            },
            {
              "name": "punctuation.separator.comma.doria",
              "match": ","
            },
            {
              "name": "entity.name.namespace.doria",
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
            }
          ]
        },
        {
          "match": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.enum.doria"
            },
            "2": {
              "name": "entity.name.type.enum.doria"
            }
          }
        },
        {
          "match": "\\b(case)\\s+([A-Z][A-Za-z0-9_]*)\\b(?=\\s*(?:[;(=]))",
          "captures": {
            "1": {
              "name": "keyword.declaration.enum.case.doria"
            },
            "2": {
              "name": "constant.other.enum.case.doria"
            }
          }
        },
        {
          "match": "\\b(class)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.class.doria"
            },
            "2": {
              "name": "entity.name.type.class.doria"
            }
          }
        },
        {
          "match": "\\b(interface)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.interface.doria"
            },
            "2": {
              "name": "entity.name.type.interface.doria"
            }
          }
        },
        {
          "match": "\\b(trait)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.trait.doria"
            },
            "2": {
              "name": "entity.name.type.trait.doria"
            }
          }
        },
        {
          "match": "\\b(static)\\s+(?:(writable)\\s+)?([A-Za-z_][A-Za-z0-9_]*(?:<[^>]+>)?(?:\\[\\])*)\\s+(\\$[A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.modifier.static.doria"
            },
            "2": {
              "name": "storage.modifier.mutability.doria"
            },
            "3": {
              "name": "storage.type.doria"
            },
            "4": {
              "name": "variable.other.property.static.doria"
            }
          }
        },
        {
          "match": "\\b(function)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.doria"
            },
            "2": {
              "name": "entity.name.function.doria"
            }
          }
        },
        {
          "match": "\\b(new)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.operator.new.doria"
            },
            "2": {
              "name": "entity.name.type.doria"
            }
          }
        },
        {
          "name": "keyword.directive.doria",
          "match": "\\b(?:include|declare)\\b"
        }
      ]
    },
    "accessors": {
      "patterns": [
        {
          "match": "(::)\\s*([A-Z](?=[A-Za-z0-9_]*[a-z])[A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "punctuation.accessor.static.doria"
            },
            "2": {
              "name": "constant.other.enum.case.doria"
            }
          }
        },
        {
          "match": "(->)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "keyword.operator.accessor.doria"
            },
            "2": {
              "name": "entity.name.function.method.call.doria"
            }
          }
        },
        {
          "match": "(->)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.operator.accessor.doria"
